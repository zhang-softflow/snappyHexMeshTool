def cmd_template(args):
    db = load_db()
    case = Path(args.case).resolve()
    surfaces = list(args.stl or [])
    shapes = []
    for spec in args.shape or []:
        if ":" not in spec:
            sys.exit(f"Error: --shape expects <type>:<name>, e.g. box:refineBox (got '{spec}')")
        t, n = spec.split(":", 1)
        g = lookup_geometry(db, t)
        if not g:
            sys.exit(f"Error: unknown geometry type '{t}'. Types: {', '.join(db['geometry'])}")
        shapes.append((t if t in SHAPE_PARAMS else g["name"], n))
    if not surfaces:
        surfaces = case_surfaces(case)
        if surfaces:
            print(f"// Using surfaces found in {case}/constant: {' '.join(surfaces)}",
                  file=sys.stderr)
    if not surfaces and not shapes:
        surfaces = ["<surface>.stl"]
    args.zone = set(args.zone or [])
    args.bounds_note = ""
    bb = blockmesh_bounds(case)
    if bb:
        args.bounds_note = "blockMesh bounds: min ({} {} {}) max ({} {} {})".format(
            *[f"{x:g}" for x in bb[0] + bb[1]])
    text = build_template(db, surfaces, shapes, args)
    # self-check: every keyword must be known to the database
    issues = check_entries(db, strip_header(parse_dict_text(text)), Path("."), None,
                           dict_only=True)
    bad = [i for i in issues if i[0] in ("ERROR", "WARN") and i[2] == "keyword"]
    if bad:
        print("Warning: template uses keywords unknown to the database:", file=sys.stderr)
        for i in bad:
            print("   ", i[3], file=sys.stderr)
    full = FOAM_BANNER.format(ver=db["version"]) + "\n" + text + FOAM_FOOTER
    if not args.write:
        print(full, end="")
        return
    target = case / "system" / "snappyHexMeshDict"
    if not (case / "system").is_dir():
        sys.exit(f"Error: {case}/system not found (use -case <case>).")
    if target.exists():
        shutil.copy2(target, target.with_name(target.name + ".bak"))
        print(f"Backup: {target}.bak")
    target.write_text(full, encoding="utf-8")
    print(f"Wrote {target}")
    left = sorted(set(re.findall(r"<[a-z]\w*>", text)))
    if left:
        print("Edit these placeholders:", " ".join(left))


