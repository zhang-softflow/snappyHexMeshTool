def child_path(parent, key):
    if parent in NAMED:
        key = NAMED[parent]
    elif parent in LIST_DICTS:
        key = "{}"
    return f"{parent}/{key}" if parent else key


def is_free(path, self_too=False):
    parts = path.split("/")
    return any(FREE_RE.match(p) for p in (parts if self_too else parts[:-1]))


def walk(entries, parent="", real_parent="", cb=None):
    """Call cb(generic path, real path, entry) for every entry recursively."""
    for e in entries:
        if e["t"] in ("include", "directive", "macro"):
            cb(parent, real_parent, e)
            continue
        path = child_path(parent, e["k"])
        real = f"{real_parent}/{e['k']}" if real_parent else e["k"]
        if cb(path, real, e) is False:
            continue
        if e["t"] == "dict":
            walk(e["ch"], path, real, cb)
        for n, item in enumerate(e.get("items", [])):
            walk(item, path + "/{}", f"{real}[{n}]", cb)


