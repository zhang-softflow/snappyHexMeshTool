def cmd_show(args):
    db = load_db()
    g = lookup_geometry(db, args.name)
    p = resolve_path(db, args.name)
    if isinstance(p, str):
        show_keyword(db, p, args)
        if g:
            print()
            show_geometry(db, g, args)
        return
    if g:
        show_geometry(db, g, args)
        return
    if isinstance(p, list) and p:
        if len(p) <= 3:
            for i, x in enumerate(p):
                if i:
                    print("\n" + "-" * 72)
                show_keyword(db, x, args)
            return
        print(f"'{args.name}' appears in several places:")
        for x in p:
            print("  " + x)
        return
    close = difflib.get_close_matches(args.name, {k["key"] for k in db["keywords"].values()},
                                      n=6, cutoff=0.6)
    msg = f"Error: unknown keyword or geometry type '{args.name}'."
    if close:
        msg += " Did you mean: " + ", ".join(close) + " ?"
    sys.exit(msg + " Try 'foamSHM search'.")


def print_block(path, line, end, max_lines=40):
    lines = read_text(path).splitlines()
    block = lines[line - 1: end]
    if len(block) > max_lines:
        block = block[:max_lines] + ["    ..."]
    print("\n".join(block))


def block_end(lines, line):
    """Closing line of the dictionary/list starting at 'line' (1-based)."""
    depth = 0
    opened = False
    for i in range(line - 1, len(lines)):
        s = blank_comments(lines[i])
        for ch in s:
            if ch in "{(":
                depth += 1
                opened = True
            elif ch in "})":
                depth -= 1
        if opened and depth <= 0:
            return i + 1
        if not opened and s.rstrip().endswith(";"):
            return i + 1
    return line


def cmd_example(args):
    db = load_db()
    root = project_dir(args.src, required=False)
    g = lookup_geometry(db, args.name)
    p = resolve_path(db, args.name) if not g else None
    if isinstance(p, list):
        p = p[0] if len(p) == 1 else None
    if g:
        items = [(fi, ln, end) for fi, ln, end in g["examples"]]
        title = f"geometry type {g['name']}"
    elif p:
        k = db["keywords"][p]
        items = [(fi, ln, None) for fi, ln, _ in k["examples"]]
        title = p
    else:
        sys.exit(f"Error: unknown keyword or geometry type '{args.name}'.")
    if not items:
        print(f"No tutorial uses {title}.")
        return
    seen = set()
    n = 0
    for fi, ln, end in items:
        if fi in seen:
            continue
        seen.add(fi)
        rel = db["tutorialFiles"][fi]
        print(c(f"# {rel}:{ln}", "1;32"))
        f = root / rel if root else None
        if f and f.is_file():
            lines = read_text(f).splitlines()
            e = end or block_end(lines, ln)
            print_block(f, ln, e)
        else:
            k = db["keywords"].get(p) if p else None
            v = next((x[2] for x in (k["examples"] if k else []) if x[0] == fi), "")
            print(f"    {args.name} {v};  (source tree not found: use --src for the full block)")
        print()
        n += 1
        if n >= args.max:
            break


