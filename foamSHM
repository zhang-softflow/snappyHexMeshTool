def new_kw(path):
    parent, _, key = path.rpartition("/")
    return {"when": [], "path": path, "key": key, "parent": parent, "kind": "", "req": "",
            "default": "", "type": "", "choices": [], "desc": "", "note": "",
            "annotated": None, "src": [], "tutorials": 0, "examples": [],
            "origin": []}


def cmd_build(args):
    root = project_dir(args.src)
    print(f"Scanning {root} ...")
    kws = {}

    def kw(path):
        if path not in kws:
            kws[path] = new_kw(path)
        return kws[path]

    # --- C++ reads
    enums = scan_enums(root)
    reads, unmapped = scan_sources(root, enums)
    for path, rs in reads.items():
        k = kw(path)
        k["origin"].append("source")
        req = any(r["required"] for r in rs)
        opt = any(not r["required"] for r in rs)
        k["req"] = "cond" if (req and opt) else ("yes" if req else "no")
        for r in rs:
            if r["default"] not in (None, "") and not k["default"]:
                k["default"] = r["default"]
            if r["type"] and not k["type"]:
                k["type"] = r["type"]
            if r["enum"] and not k["choices"]:
                k["choices"] = enums.get(r["enum"], {}).get("names", [])
            if r["call"] in ("subDict", "subOrEmptyDict", "optionalSubDict", "isDict", "findDict"):
                k["kind"] = "dict"
            k["src"].append(f"{r['file']}:{r['line']} {r['call']}")
        k["src"] = sorted(set(k["src"]))
        files = {Path(r["file"]).name for r in rs}
        when = []
        if path.startswith(ALC + "/"):
            when.append("addLayers")
        if files == {"medialAxisMeshMover.C"}:
            when.append("medialAxis")
        if files <= {"motionSmootherAlgo.C"}:
            when.append("snapOrLayers")
        k["when"] = when

    # --- annotated dictionaries
    annotated_real = set()
    commented_dropped = []

    def take_annotated(entries, rel, flagged, prefix=""):
        found = []

        def cb(path, real, e):
            if e["t"] in ("include", "directive", "macro"):
                return
            if prefix:
                path = f"{prefix}/{path}"
            found.append((path, e, e["line"] in flagged))
        walk(entries, "", "", cb)
        return found

    sources = []
    txt = read_text(root / ANNOTATED)
    if txt:
        utxt, flagged = uncomment_examples(txt)
        sources.append((ANNOTATED, take_annotated(strip_header(parse_dict_text(utxt)),
                                                  ANNOTATED, flagged)))
    txt = read_text(root / QUALITY_DICT)
    if txt:
        utxt, flagged = uncomment_examples(txt)
        sources.append((QUALITY_DICT, take_annotated(strip_header(parse_dict_text(utxt)),
                                                     QUALITY_DICT, flagged, MQC)))
    for rel, found in sources:
        for path, e, commented in found:
            if not commented:
                annotated_real.add(path)
    # --- tutorials (real usage)
    tut_files = find_tutorial_dicts(root)
    tut_rel = [str(f.relative_to(root)) for f in tut_files]
    geom = scan_geometry_types(root)
    gname = {}
    for g in geom.values():
        for n in g["names"]:
            gname[n] = g["name"]
    tut_paths = {}
    for fi, f in enumerate(tut_files):
        entries = strip_header(parse_dict_text(read_text(f)))
        seen = set()

        def cb(path, real, e, fi=fi, seen=seen):
            if e["t"] in ("include", "directive", "macro"):
                return
            if e["k"].startswith("_"):
                return False      # user macro variables (skip the subtree)
            v = e.get("v", "") if e["t"] == "value" else "{...}"
            tut_paths.setdefault(path, []).append([fi, e["line"], v[:120]])
            seen.add(path)
            # geometry type usage
            if path == GEO and e["t"] == "dict":
                tv = next((c_["v"] for c_ in e["ch"] if c_["k"] == "type"), "")
                g = gname.get(tv)
                if g:
                    G = geom[g]
                    G["tutorials"] += 1
                    if len(G["examples"]) < 30:
                        G["examples"].append([fi, e["line"], e["end"]])
                    for c_ in e["ch"]:
                        if c_["k"] not in GEOM_COMMON:
                            G["keys"][c_["k"]] = G["keys"].get(c_["k"], 0) + 1
        walk(entries, "", "", cb)

    def is_geom_param(path):
        return path.startswith(GEO + "/") and path.split("/")[2] not in GEOM_COMMON

    # merge annotated
    for rel, found in sources:
        for path, e, commented in found:
            if is_geom_param(path):
                continue
            confirmed = (path in kws or path in annotated_real or path in tut_paths
                         or is_free(path, True))
            if commented and not confirmed:
                commented_dropped.append(f"{rel}:{e['line']} {path}")
                continue
            k = kw(path)
            if "annotated" not in k["origin"]:
                k["origin"].append("annotated")
            desc = "\n".join(l for l in e.get("pre", [])
                             if l.strip() and not re.fullmatch(r"[~\-=*\s]+", l))
            post = e.get("post", "")
            info = {"file": rel, "line": e["line"],
                    "value": e.get("v", "") if e["t"] == "value" else "",
                    "commented": commented}
            if e["t"] == "dict":
                k["kind"] = "dict"
            if k["annotated"] is None:
                k["annotated"] = info
                k["desc"] = (desc + ("\n" + post if post else "")).strip()
            else:
                # keep other example values (e.g. thicknessModel alternatives)
                vals = k["annotated"].setdefault("alternatives", [])
                if info["value"] and info["value"] != k["annotated"]["value"] \
                        and info["value"] not in vals:
                    vals.append(info["value"])
                    if desc and k["desc"] and k["annotated"]["value"]:
                        if not k["desc"].startswith("["):
                            k["desc"] = f"[{k['annotated']['value']}] " + k["desc"]
                        k["desc"] += f"\n[{info['value']}] " + desc.replace("\n", " ")
                if not k["desc"] and (desc or post):
                    k["desc"] = (desc + ("\n" + post if post else "")).strip()
                if not commented:
                    k["annotated"]["commented"] = False

    # merge cfg values
    for rel, prefix in CFG_DICTS:
        txt = read_text(root / rel)
        if not txt:
            continue

        def cb(path, real, e, rel=rel, prefix=prefix):
            if e["t"] != "value":
                return
            p = f"{prefix}/{path}" if prefix else path
            if p in kws:
                kws[p].setdefault("cfg", {"file": rel, "value": e["v"]})
        walk(strip_header(parse_dict_text(txt)), "", "", cb)

    # merge tutorials
    tutorial_only = []
    for path, ex in tut_paths.items():
        if is_geom_param(path):
            continue
        if path not in kws:
            if path.startswith(MQC + "/relaxed/") and (MQC + "/" + path.split("/")[-1]) in kws:
                continue
            k = kw(path)
            if not is_free(path, True) and not k["key"].startswith("<"):
                tutorial_only.append(path)
            k["origin"].append("tutorials")
        k = kws[path]
        k["tutorials"] = len({x[0] for x in ex})
        k["examples"] = ex[:25]

    # structure: make sure all parents exist and are dictionaries
    for path in list(kws):
        parts = path.split("/")
        for i in range(1, len(parts)):
            par = "/".join(parts[:i])
            p = kw(par)
            if not p["kind"]:
                p["kind"] = "dict"
    for path, k in kws.items():
        if not k["kind"]:
            ex = k["examples"]
            k["kind"] = "dict" if ex and all(x[2] == "{...}" for x in ex) else "value"
        if path in NAMED:
            k["kind"] = "named"
        if path in LIST_DICTS:
            k["kind"] = "list"
        if path in REQ_OVERRIDE:
            k["req"], k["note"] = REQ_OVERRIDE[path]
        if not k["choices"]:
            if k["key"] in ENUM_LINKS:
                k["choices"] = enums.get(ENUM_LINKS[k["key"]], {}).get("names", [])
            elif k["key"] in EXTRA_CHOICES:
                k["choices"] = EXTRA_CHOICES[k["key"]]
        if not k["req"]:
            k["req"] = "" if ("source" not in k["origin"]) else "no"
        k["aliases"] = ALIASES.get(path, "")
        k["free"] = is_free(path, True)
    # parallel structures share the meaning of their entries
    borrow = [(ALC + "/layers/<patch>/", ALC + "/"), (RS + "/regions/<region>/", RS + "/"),
              (LR + "/", RR + "/"), (RR + "/regions/<region>/", RR + "/"),
              (RS + "/", RR + "/"), (RS + "/regions/<region>/", RR + "/"),
              (CMC + "/faceZoneControls/<faceZone>/", RS + "/")]
    for _ in range(2):
        for path, k in kws.items():
            if k["desc"]:
                continue
            for dst, src in borrow:
                if path.startswith(dst) and "/" not in path[len(dst):]:
                    other = kws.get(src + path[len(dst):])
                    if other and other["desc"] and not other.get("borrowed"):
                        k["desc"] = other["desc"]
                        k["borrowed"] = other["path"]
                        break
    movers = scan_movers(root)
    if ALC + "/meshShrinker" in kws:
        kws[ALC + "/meshShrinker"]["choices"] = movers
    # placeholders inside a named container are dictionaries, required if
    # the container is
    for path, k in kws.items():
        if k["key"].startswith("<") or k["key"] == "{}":
            k["kind"] = "dict"
            k["req"] = ""

    db = {
        "tool": "foamSHM",
        "version": root.name,
        "built": date.today().isoformat(),
        "named": NAMED,
        "listDicts": sorted(LIST_DICTS),
        "topSections": TOP_SECTIONS,
        "enums": {k: v["names"] for k, v in enums.items()},
        "tutorialFiles": tut_rel,
        "keywords": dict(sorted(kws.items())),
        "geometry": dict(sorted(geom.items(), key=lambda kv: kv[0].lower())),
    }
    out = Path(args.output) if args.output else user_db_path(root.name)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(db, indent=1, ensure_ascii=False), encoding="utf-8")

    vals = [k for k in kws.values() if k["kind"] == "value"]
    print(f"Wrote {out}")
    if not args.output and current_version() != root.name:
        print(f"  note: used automatically when $WM_PROJECT_DIR ends with '{root.name}';"
              f" otherwise set FOAMSHM_DB={out}")
    print(f"  keyword paths       : {len(kws)} ({len(vals)} values)")
    print(f"  read in the sources : {sum(1 for k in kws.values() if 'source' in k['origin'])}")
    print(f"  in annotated dicts  : {sum(1 for k in kws.values() if 'annotated' in k['origin'])}")
    print(f"  used in tutorials   : {sum(1 for k in kws.values() if k['tutorials'])}"
          f" (from {len(tut_files)} files)")
    print(f"  geometry types      : {len(geom)}")
    print(f"  enum tables         : {len(enums)}")
    no_src = sorted(p for p in annotated_real if p in kws and "source" not in kws[p]["origin"]
                    and not is_free(p) and not p.startswith(MQC + "/relaxed/")
                    and kws[p]["kind"] != "dict" and not kws[p]["key"].startswith("<"))
    no_ann = sorted(p for p, k in kws.items() if "source" in k["origin"]
                    and "annotated" not in k["origin"])
    print(f"  source-only keywords (not in annotated): {len(no_ann)}")
    print(f"  annotated but no source read found     : {len(no_src)}")
    print(f"  tutorial-only keywords                 : {len(tutorial_only)}")
    if args.verbose:
        def show(title, items):
            print(f"\n[{title}]")
            for x in items:
                print("   ", x)
        show("source-only (not in annotated)", no_ann)
        show("annotated, no source read found", no_src)
        show("tutorial-only (not in sources/annotated)", sorted(tutorial_only))
        show("commented annotated entries dropped (unconfirmed)", commented_dropped)
        show("unmapped source reads (other dictionaries)", unmapped)


