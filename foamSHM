def resolve_include(name, cur_file, case, root):
    name = name.replace("<system>", str(case / "system")) \
               .replace("<constant>", str(case / "constant")) \
               .replace("<case>", str(case))
    name = os.path.expandvars(name)
    p = Path(name)
    if not p.is_absolute():
        p = cur_file.parent / name
    return p if p.is_file() else None


def load_with_includes(path, case, root, depth=0):
    """Parse a dictionary file and splice in #include / #includeEtc files.

    Returns (entries, notes). Entries keep 'file' to report locations.
    Dictionaries with unresolved includes or $macros get 'incomplete'.
    """
    notes = []
    entries = strip_header(parse_dict_text(read_text(path)))

    def splice(ents, cur):
        out = []
        incomplete = False
        for e in ents:
            e["file"] = str(cur)
            if e["t"] == "include":
                inc = None
                if e["k"] in ("#include", "#includeIfPresent"):
                    inc = resolve_include(e["v"], cur, case, root)
                elif e["k"] == "#includeEtc" and root:
                    cand = root / "etc" / e["v"]
                    inc = cand if cand.is_file() else None
                if inc and depth < 8:
                    sub, n2 = load_with_includes(inc, case, root, depth + 1)
                    notes.extend(n2)
                    out.extend(sub)
                    continue
                if e["k"] != "#includeIfPresent":
                    notes.append((e, f"cannot resolve {e['k']} \"{e['v']}\""))
                    incomplete = True
                continue
            if e["t"] == "macro":
                incomplete = True
                out.append(e)
                continue
            if e["t"] == "dict":
                e["ch"], inc2 = splice(e["ch"], cur)
                e["incomplete"] = inc2
            for n, item in enumerate(e.get("items", [])):
                e["items"][n], _ = splice(item, cur)
            out.append(e)
        return merge_entries(out), incomplete

    entries, inc = splice(entries, path)
    if inc:
        entries.insert(0, {"k": "__incomplete__", "t": "marker", "line": 0})
    return entries, notes


def merge_entries(entries):
    """Later entries override earlier ones; dictionaries are merged."""
    out = []
    index = {}
    for e in entries:
        k = e["k"]
        if e["t"] in ("macro", "directive", "include", "marker"):
            out.append(e)
            continue
        if k in index:
            old = out[index[k]]
            if old["t"] == "dict" and e["t"] == "dict":
                old["ch"] = merge_entries(old["ch"] + e["ch"])
                old["incomplete"] = old.get("incomplete") or e.get("incomplete")
                continue
            out[index[k]] = e
            continue
        index[k] = len(out)
        out.append(e)
    return out


def blockmesh_bounds(case):
    for f in (case / "system" / "blockMeshDict", case / "constant" / "polyMesh" / "blockMeshDict"):
        if not f.is_file():
            continue
        ents = strip_header(parse_dict_text(read_text(f)))
        d = {e["k"]: e for e in ents}
        v = d.get("vertices")
        if not v or v["t"] != "value" or re.search(r"[$#]", v["v"]):
            return None
        pts = re.findall(r"\(\s*([-+\d.eE]+)\s+([-+\d.eE]+)\s+([-+\d.eE]+)\s*\)", v["v"])
        if not pts:
            return None
        try:
            pts = [[float(x) for x in p] for p in pts]
        except ValueError:
            return None
        s = 1.0
        for key in ("scale", "convertToMeters"):
            if key in d and d[key]["t"] == "value":
                try:
                    s = float(d[key]["v"])
                except ValueError:
                    return None
        lo = [min(p[i] for p in pts) * s for i in range(3)]
        hi = [max(p[i] for p in pts) * s for i in range(3)]
        return lo, hi
    return None


def known_child_keys(db, path):
    return {k["key"] for k in children(db, path)}


def check_entries(db, entries, case, root, dict_only=False, notes=()):
    """Return a list of (level, location, category, message)."""
    kws = db["keywords"]
    issues = []
    macros_defined = set()

    def loc(e):
        f = e.get("file")
        return f"{Path(f).name}:{e['line']}" if f else f"line {e['line']}"

    def collect_macros(ents):
        for e in ents:
            if e["t"] == "dict":
                collect_macros(e["ch"])
            macros_defined.add(e["k"])
    collect_macros(entries)

    for e, msg in notes:
        issues.append(("INFO", loc(e), "include", msg + " (its entries are not checked)"))

    def suggest(parent, key):
        cands = known_child_keys(db, parent)
        close = difflib.get_close_matches(key, cands, n=3, cutoff=0.6)
        if not close:
            close = difflib.get_close_matches(key.lower(), [x.lower() for x in cands], n=3,
                                              cutoff=0.6)
            close = [x for x in cands if x.lower() in close]
        return close

    def where_else(key):
        return sorted({k["parent"] or "(top level)" for k in kws.values()
                       if k["key"] == key and not k["free"]})

    def check_value(path, e):
        k = kws.get(path)
        if not k or not k["choices"] or e["t"] != "value":
            return
        v = e["v"].strip('"')
        if path.endswith("Flags"):
            vals = re.findall(r"\w+", v)
        else:
            vals = [v]
        for x in vals:
            if re.fullmatch(r"\w+", x) and x not in k["choices"] and not x.startswith("$"):
                issues.append(("ERROR", loc(e), "value",
                               f"{path}: '{x}' is not one of {' | '.join(k['choices'])}"))

    def rec(ents, parent, incomplete):
        present = set()
        for e in ents:
            if e["t"] in ("include", "directive", "macro", "marker"):
                continue
            key = e["k"]
            present.add(key)
            path = child_path(parent, key)
            if key in macros_defined and key.startswith("_"):
                continue
            if is_free(path, True):
                continue
            # geometry type-specific parameters are checked separately
            if parent == GEO and key not in GEOM_COMMON:
                continue
            if parent == MQC + "/relaxed":
                if (MQC + "/" + key) not in kws:
                    close = suggest(MQC, key)
                    issues.append(("WARN", loc(e), "keyword",
                                   f"unknown mesh-quality keyword '{key}' in relaxed"
                                   + (f" (did you mean: {', '.join(close)}?)" if close else "")))
                continue
            if path not in kws:
                close = suggest(parent, key)
                other = where_else(key)
                msg = f"unknown keyword '{key}' in {parent or 'top level'}"
                if close:
                    msg += f" (did you mean: {', '.join(close)}?)"
                elif other:
                    msg += f" (it belongs to: {', '.join(other[:3])})"
                issues.append(("WARN", loc(e), "keyword", msg))
                continue
            k = kws[path]
            if not k["req"] and "source" not in k["origin"] and k["kind"] == "value" \
                    and "annotated" not in k["origin"]:
                issues.append(("INFO", loc(e), "keyword",
                               f"'{path}' is used in tutorials but no read was found in the "
                               "sources; it may be ignored"))
            check_value(path, e)
            if e["t"] == "dict":
                rec(e["ch"], path, incomplete or e.get("incomplete"))
            for item in e.get("items", []):
                rec(item, path + "/{}", incomplete)
        # missing mandatory entries
        if incomplete or (parent and parent.split("/")[-1] in ("<region>",)):
            return
        if parent.startswith(GEO):
            return
        for k in children(db, parent):
            if k["req"] == "yes" and k["key"] not in present and not k["key"].startswith("<") \
                    and all(active.get(w, True) for w in k.get("when", [])):
                if k["kind"] == "dict" and parent == "" and k["key"] not in TOP_SECTIONS:
                    continue
                issues.append(("ERROR", f"in {parent or 'top level'}", "missing",
                               f"mandatory entry '{k['key']}' is missing in "
                               f"{parent or 'top level'}"
                               + (f" (default in etc cfg: {k['cfg']['value']})"
                                  if k.get("cfg") else "")))

    top_incomplete = any(e["t"] == "marker" for e in entries)
    topv = {e["k"]: e.get("v", "") for e in entries if e["t"] == "value"}
    add_layers = topv.get("addLayers", "false") in ("true", "on", "yes", "1")
    alc = next((e for e in entries if e["k"] == ALC and e["t"] == "dict"), None)
    shrinker = next((x.get("v", "") for x in (alc["ch"] if alc else [])
                     if x["k"] == "meshShrinker"), "displacementMedialAxis")
    snap = topv.get("snap", "false") in ("true", "on", "yes", "1")
    active = {"addLayers": add_layers, "medialAxis": shrinker == "displacementMedialAxis",
              "snapOrLayers": snap or add_layers}
    rec(entries, "", top_incomplete)

    # ---- cross checks
    d = {e["k"]: e for e in entries if e["t"] == "dict"}
    geom = d.get("geometry")
    cmc = d.get(CMC)
    gnames = {}
    if geom:
        for e in geom["ch"]:
            if e["t"] != "dict":
                continue
            ch = {x["k"]: x for x in e["ch"]}
            tval = ch.get("type", {}).get("v", "").strip('"')
            name = ch.get("name", {}).get("v", e["k"]).strip('"')
            gnames[name] = (e, tval)
            g = lookup_geometry(db, tval) if tval else None
            if not tval:
                issues.append(("ERROR", loc(e), "geometry", f"geometry '{e['k']}' has no type"))
                continue
            if not g:
                if not tval.startswith("$"):
                    issues.append(("ERROR", loc(e), "geometry",
                                   f"geometry '{e['k']}': unknown type '{tval}' "
                                   f"(types: {', '.join(db['geometry'])})"))
                continue
            known = {r["name"] for t in g["tables"] for r in t["rows"]} | set(g["keys"]) \
                | GEOM_COMMON
            # parameters of other surfaces wrapped by this type
            if g["name"] in ("searchableSurfaceWithGaps", "searchableSurfaceCollection",
                             "subTriSurfaceMesh", "distributedTriSurfaceMesh"):
                known = None
            for x in e["ch"]:
                if x["t"] in ("include", "directive", "macro"):
                    continue
                if known is not None and x["k"] not in known:
                    close = difflib.get_close_matches(x["k"], known, n=3, cutoff=0.6)
                    issues.append(("WARN" if close else "INFO", loc(x), "geometry",
                                   f"geometry '{e['k']}' ({g['name']}): parameter "
                                   f"'{x['k']}' is not documented for this type"
                                   + (f" (did you mean: {', '.join(close)}?)" if close else "")))
            for t in g["tables"]:
                for r in t["rows"]:
                    if r["reqd"] == "yes" and r["name"] not in ch and r["name"] != "type":
                        alt = {"min": "span", "max": "span"}.get(r["name"])
                        if alt and alt in ch:
                            continue
                        issues.append(("ERROR", loc(e), "geometry",
                                       f"geometry '{e['k']}' ({g['name']}): mandatory "
                                       f"parameter '{r['name']}' is missing"))
            # surface files
            if not dict_only and ("TriSurfaceMesh" in g["class"]
                                  or g["class"] == "triSurfaceMesh"):
                fname = ch.get("file", {}).get("v", e["k"]).strip('"')
                if not any((dd / fname).is_file() or (dd / (fname + ".gz")).is_file()
                           for dd in surface_dirs(case)):
                    issues.append(("WARN", loc(e), "file",
                                   f"surface file '{fname}' not found in constant/triSurface "
                                   "(or constant/geometry)"))
    if cmc:
        cd = {x["k"]: x for x in cmc["ch"]}
        for sect in ("refinementSurfaces", "refinementRegions", "limitRegions"):
            s = cd.get(sect)
            if not s or s["t"] != "dict" or not geom:
                continue
            for x in s["ch"]:
                if x["t"] != "dict":
                    continue
                if x["k"] not in gnames and not re.search(r"[|.*()]", x["k"]):
                    close = difflib.get_close_matches(x["k"], list(gnames), n=3, cutoff=0.5)
                    issues.append(("WARN", loc(x), "geometry",
                                   f"{sect}: '{x['k']}' is not a geometry name, so it is "
                                   f"not used (names: {', '.join(gnames) or '-'})"
                                   + (f" - did you mean {close[0]}?" if close else "")))
        feats = cd.get("features")
        if feats and not dict_only:
            for item in feats.get("items", []):
                fe = {x["k"]: x for x in item}
                if "file" in fe:
                    fn = fe["file"]["v"].strip('"')
                    if fn.startswith("$"):
                        continue
                    dirs = surface_dirs(case) + [case / "constant" / "extendedFeatureEdgeMesh"]
                    if not any((dd / fn).is_file() or (dd / (fn + ".gz")).is_file()
                               for dd in dirs):
                        issues.append(("WARN", loc(fe["file"]), "file",
                                       f"feature file '{fn}' not found; create it with "
                                       "surfaceFeatureExtract (system/surfaceFeatureExtractDict)"))
        # locationInMesh inside the background mesh
        if not dict_only:
            bb = blockmesh_bounds(case)
            pts = []
            if "locationInMesh" in cd:
                pts.append((cd["locationInMesh"], cd["locationInMesh"]["v"]))
            if "locationsInMesh" in cd:
                for m in re.finditer(r"\(\s*([-+\d.eE]+\s+[-+\d.eE]+\s+[-+\d.eE]+)\s*\)",
                                     cd["locationsInMesh"]["v"]):
                    pts.append((cd["locationsInMesh"], "(" + m.group(1) + ")"))
            for e, v in pts:
                m = re.fullmatch(r"\(\s*([-+\d.eE]+)\s+([-+\d.eE]+)\s+([-+\d.eE]+)\s*\)", v.strip())
                if not m or not bb:
                    continue
                p = [float(x) for x in m.groups()]
                if not all(bb[0][i] < p[i] < bb[1][i] for i in range(3)):
                    issues.append(("ERROR", loc(e), "location",
                                   f"location {v} is outside the blockMesh bounds "
                                   f"({' '.join(f'{x:g}' for x in bb[0])}) - "
                                   f"({' '.join(f'{x:g}' for x in bb[1])})"))
    # switches
    for sw, sect in (("addLayers", ALC),):
        e = next((x for x in entries if x["k"] == sw), None)
        if e and e.get("v") in ("true", "on", "yes", "1"):
            a = d.get(ALC)
            if a:
                lay = next((x for x in a["ch"] if x["k"] == "layers"), None)
                if lay is not None and lay["t"] == "dict" and not lay["ch"]:
                    issues.append(("WARN", loc(lay), "layers",
                                   "addLayers is true but addLayersControls/layers is empty"))
    return issues


def cmd_check(args):
    db = load_db()
    root = project_dir(args.src, required=False)
    p = Path(args.case).resolve()
    if p.is_dir():
        case = p
        f = p / "system" / "snappyHexMeshDict"
    else:
        f = p
        case = p.parent.parent if p.parent.name == "system" else p.parent
    if not f.is_file():
        sys.exit(f"Error: {f} not found.")
    entries, notes = load_with_includes(f, case, root)
    issues = check_entries(db, entries, case, root, dict_only=args.dict_only, notes=notes)
    if args.quiet:
        issues = [i for i in issues if i[0] != "INFO"]
    colors = {"ERROR": "1;31", "WARN": "1;33", "INFO": "36"}
    print(c(f"Checking {f}", "1"))
    for lvl, where, cat, msg in issues:
        print(f"  {c(lvl.ljust(5), colors[lvl])} {where:<28} [{cat}] {msg}")
    ne = sum(1 for i in issues if i[0] == "ERROR")
    nw = sum(1 for i in issues if i[0] == "WARN")
    if not issues:
        print("  OK: no problems found.")
    else:
        print(f"  {ne} error(s), {nw} warning(s)")
    if root:
        print(c("Tip:", "2"), "also run 'foamDictionary system/snappyHexMeshDict -expand' "
              "and 'snappyHexMesh -dry-run' for a full check.")
    sys.exit(1 if ne else 0)


