def main():
    p = argparse.ArgumentParser(prog="foamSHM", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=f"%(prog)s {__version__}")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("build", help="scan OpenFOAM sources and build the database")
    s.add_argument("--src", help="OpenFOAM source root (default: $WM_PROJECT_DIR)")
    s.add_argument("-o", "--output",
                   help="database file (default: ~/.local/share/foamSHM/shmDatabase-<version>.json)")
    s.add_argument("-v", "--verbose", action="store_true",
                   help="list keywords found only in one source (for review)")
    s.set_defaults(func=cmd_build)

    s = sub.add_parser("tree", help="show the dictionary structure")
    s.add_argument("path", nargs="?", help="start at this section, e.g. addLayersControls")
    s.add_argument("-a", "--all", action="store_true",
                   help="also show tutorial-only entries and free sub-dictionaries")
    s.add_argument("-d", "--desc", action="store_true", help="show short descriptions")
    s.add_argument("--depth", type=int, help="maximum depth")
    s.set_defaults(func=cmd_tree)

    s = sub.add_parser("search", help="search keywords/descriptions (all words must match)")
    s.add_argument("keywords", nargs="+")
    s.add_argument("-m", "--max", type=int, default=25)
    s.set_defaults(func=cmd_search)

    s = sub.add_parser("show", help="show a keyword (path or name) or a geometry type")
    s.add_argument("name")
    s.add_argument("-m", "--max", type=int, default=5, help="max tutorial references")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("example", help="print usage taken from the tutorials")
    s.add_argument("name")
    s.add_argument("-m", "--max", type=int, default=3)
    s.add_argument("--src", help="OpenFOAM root (default: $WM_PROJECT_DIR)")
    s.set_defaults(func=cmd_example)

    s = sub.add_parser("template", help="generate a snappyHexMeshDict")
    s.add_argument("-case", "--case", default=".", help="case directory (default: cwd)")
    s.add_argument("--stl", action="append",
                   help="surface file in constant/triSurface (repeatable; default: all found)")
    s.add_argument("--shape", action="append",
                   help="analytic refinement region <type>:<name>, e.g. box:refineBox (repeatable)")
    s.add_argument("--level", type=int, nargs=2, default=[2, 3], metavar=("MIN", "MAX"),
                   help="surface refinement level (default: 2 3)")
    s.add_argument("--layers", type=int, default=0, metavar="N",
                   help="add N boundary layers on the surfaces (sets addLayers true)")
    s.add_argument("--features", action="store_true",
                   help="explicit feature edge refinement/snapping (<surface>.eMesh)")
    s.add_argument("--zone", action="append",
                   help="make faceZone/cellZone from this surface (base name, repeatable)")
    s.add_argument("--location", help="locationInMesh, e.g. '(0.1 0.2 0.3)'")
    s.add_argument("--include-quality", action="store_true",
                   help="use #include \"meshQualityDict\" instead of inline values")
    s.add_argument("--write", action="store_true",
                   help="write <case>/system/snappyHexMeshDict (backup .bak)")
    s.set_defaults(func=cmd_template)

    s = sub.add_parser("check", help="check a snappyHexMeshDict")
    s.add_argument("case", nargs="?", default=".", help="case directory or dictionary file")
    s.add_argument("--dict-only", action="store_true",
                   help="only check the dictionary (no surface files / blockMesh)")
    s.add_argument("-q", "--quiet", action="store_true", help="hide INFO messages")
    s.add_argument("--src", help="OpenFOAM root for #includeEtc (default: $WM_PROJECT_DIR)")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("html", help="generate catalog.html")
    s.add_argument("-o", "--output")
    s.set_defaults(func=cmd_html)

    args = p.parse_args()
    try:
        args.func(args)
    except BrokenPipeError:
        pass


if __name__ == "__main__":
    main()
