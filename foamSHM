def read_text(path):
    try:
        path = Path(path)
        if path.suffix == ".gz":
            with gzip.open(path, "rt", encoding="utf-8", errors="replace") as f:
                return f.read()
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def blank_comments(text):
    """Replace C/C++ comments by blanks, keeping newlines (line numbers)."""
    def rep(m):
        return re.sub(r"[^\n]", " ", m.group(0))
    text = re.sub(r'"(?:[^"\\\n]|\\.)*"|/\*.*?\*/|//[^\n]*',
                  lambda m: m.group(0) if m.group(0).startswith('"') else rep(m),
                  text, flags=re.S)
    return text


def line_of(text, pos):
    return text.count("\n", 0, pos) + 1


# --- doxygen header parsing (same format as foamFO / foamFV) ---------------

SECTION_RE = re.compile(r"^([A-Z][A-Za-z ]{1,30})\s*$")
LINK_RE = re.compile(r"\\link\s+([\w.]+)\s+\\endlink")


def header_comment(text):
    m = re.search(r"\\\*-{5,}[-*]*\*/", text)
    if not m:
        return ""
    block = text[: m.start()]
    idx = block.find("\nClass")
    if idx < 0:
        idx = block.find("\nDescription")
    return block[idx + 1:] if idx >= 0 else block


def split_sections(comment):
    sections = {}
    current = None
    buf = []

    def flush():
        if current:
            old = sections.get(current)
            txt = "\n".join(buf)
            sections[current] = old + "\n\n" + txt if old else txt
    for line in comment.splitlines():
        m = SECTION_RE.match(line)
        if m and not line.startswith(" "):
            flush()
            current = m.group(1).strip()
            buf = []
        elif current:
            buf.append(line)
    flush()
    return sections


def dedent(text):
    lines = text.splitlines()
    ind = [len(l) - len(l.lstrip()) for l in lines if l.strip()]
    cut = min(ind) if ind else 0
    return "\n".join(l[cut:] for l in lines).strip("\n")


def extract_verbatims(text):
    out = []
    for part in re.split(r"\\verbatim[ \t]*\n", text)[1:]:
        end = part.find("\\endverbatim")
        out.append(dedent(part[:end] if end >= 0 else part))
    return out


def clean_doxygen(text):
    text = re.sub(r"\\verbatim.*?\\endverbatim", "", text, flags=re.S)
    text = re.sub(r"\\table.*?\\endtable", "", text, flags=re.S)
    text = re.sub(r"\\heading\s+[^\n]*", "", text)
    text = LINK_RE.sub(r"\1", text)
    text = re.sub(r"\\(c|a|b|em|p)\s+", "", text)
    text = text.replace("\\<", "<").replace("\\>", ">")
    text = re.sub(r"\n\s*\n\s*\n+", "\n\n", text)
    return dedent(text)


def parse_tables(text):
    tables = []
    for m in re.finditer(r"(?:\\heading\s+([^\n]*)\n\s*)?\\table\s*\n(.*?)\\endtable",
                         text, re.S):
        body = m.group(2).replace("\\<", "<").replace("\\>", ">")
        lines = [l.strip() for l in body.splitlines() if "|" in l]
        if not lines:
            continue
        head = [c_.strip().lower() for c_ in lines[0].split("|")]
        cols = {}
        for i, h in enumerate(head):
            if h.startswith("prop") or h in ("entry", "keyword", "name"):
                cols.setdefault("name", i)
            elif h.startswith("desc"):
                cols.setdefault("desc", i)
            elif h.startswith("type"):
                cols.setdefault("type", i)
            elif h.startswith("req") or h.startswith("mand"):
                cols.setdefault("reqd", i)
            elif h.startswith("def") or h.startswith("dflt"):
                cols.setdefault("default", i)
        if "name" not in cols:
            continue
        rows = []
        for l in lines[1:]:
            cells = [c_.strip() for c_ in l.split("|")]

            def cell(key):
                i = cols.get(key)
                return cells[i] if i is not None and i < len(cells) else ""
            name = cell("name")
            if not name:
                continue
            reqd = cell("reqd").lower()
            if reqd.startswith(("yes", "y")):
                reqd = "yes"
            elif reqd.startswith("no"):
                reqd = "no"
            elif reqd.startswith(("cnd", "cond")):
                reqd = "cond"
            rows.append({"name": name,
                         "desc": re.sub(r"\s+", " ", LINK_RE.sub(r"\1", cell("desc"))),
                         "type": cell("type"), "reqd": reqd,
                         "default": "" if cell("default") in ("-", "") else cell("default")})
        if rows:
            tables.append({"heading": (m.group(1) or "").strip(), "rows": rows})
    return tables


# ---------------------------------------------------------------------------
# OpenFOAM dictionary parser (keeps line numbers and comments)
# ---------------------------------------------------------------------------

TOKEN_RE = re.compile(r"""
    (?P<lc>//[^\n]*)
  | (?P<bc>/\*.*?\*/)
  | (?P<code>\#\{.*?\#\})
  | (?P<str>"(?:[^"\\]|\\.)*")
  | (?P<var>\$\{[^}]*\}|\$[^\s{}();\[\]"]+)
  | (?P<p>[{}();\[\]])
  | (?P<w>(?:[^\s{}();\[\]"/]|/(?![/*]))+)
""", re.S | re.X)


def tokenize(text):
    toks = []
    for m in TOKEN_RE.finditer(text):
        kind = m.lastgroup
        line = line_of_cache(text, m.start())
        end = line + m.group(0).count("\n")
        toks.append((kind, m.group(0), line, end))
    return toks


_LINE_CACHE = {}


def line_of_cache(text, pos):
    key = id(text)
    starts = _LINE_CACHE.get(key)
    if starts is None or starts[0] is not text:
        idx = [0]
        for m in re.finditer("\n", text):
            idx.append(m.end())
        starts = (text, idx)
        _LINE_CACHE.clear()
        _LINE_CACHE[key] = starts
    import bisect
    return bisect.bisect_right(starts[1], pos)


def clean_comment(text):
    if text.startswith("/*"):
        text = text[2:-2]
        lines = [re.sub(r"^\s*\*?\s?", "", l) for l in text.splitlines()]
    else:
        lines = [re.sub(r"^(?:\s*//[-/]*)+\s?", "", text)]
    return [l.rstrip() for l in lines]


def join_value(parts):
    s = " ".join(parts)
    s = re.sub(r"\(\s+", "(", s)
    s = re.sub(r"\s+\)", ")", s)
    return s


class DictParser:
    """Tolerant parser. Entries are dicts:
        k (key), line, end, t ('dict' | 'value' | 'include' | 'macro'),
        v (value text), ch (children for 'dict'), items (dicts inside a list),
        pre (comment lines above), post (trailing comment)
    """

    def __init__(self, text):
        self.toks = tokenize(text)
        self.i = 0
        self.pending = []

    def peek(self, skip_comments=True):
        j = self.i
        while j < len(self.toks):
            if not (skip_comments and self.toks[j][0] in ("lc", "bc")):
                return self.toks[j]
            j += 1
        return None

    def next(self):
        """Next significant token; comments are collected in self.pending."""
        while self.i < len(self.toks):
            t = self.toks[self.i]
            self.i += 1
            if t[0] in ("lc", "bc"):
                self.pending.append(t)
                continue
            return t
        return None

    def take_pre(self, key_line):
        """Comments directly above key_line (a contiguous block)."""
        block = []
        expect = key_line
        for t in reversed(self.pending):
            if t[3] == expect - 1 or (t[3] == expect and t[2] == expect and not block):
                block.insert(0, t)
                expect = t[2]
            else:
                break
        self.pending = []
        out = []
        for t in block:
            out.extend(clean_comment(t[1]))
        return out

    def take_post(self, end_line):
        j = self.i
        if j < len(self.toks) and self.toks[j][0] in ("lc", "bc") and self.toks[j][2] == end_line:
            self.i += 1
            return " ".join(clean_comment(self.toks[j][1])).strip()
        return ""

    def parse(self):
        return self.parse_entries(top=True)

    def parse_entries(self, top=False):
        entries = []
        while True:
            t = self.next()
            if t is None:
                return entries
            kind, txt, line, _ = t
            if kind == "p":
                if txt == "}":
                    if top:
                        continue
                    return entries
                continue          # stray ; ( ) [ ]
            if kind == "code":
                continue
            pre = self.take_pre(line)
            if kind == "w" and txt.startswith("#"):
                e = {"k": txt, "line": line, "end": line, "t": "include"
                     if txt.startswith("#include") else "directive", "v": "", "pre": pre}
                nt = self.peek()
                if nt and nt[0] in ("str", "w", "var") and nt[2] == line:
                    self.next()
                    e["v"] = nt[1].strip('"')
                elif nt and nt[1] == "(":
                    self.read_value()
                entries.append(e)
                continue
            if kind == "var":
                e = {"k": txt, "line": line, "end": line, "t": "macro", "v": "", "pre": pre}
                nt = self.peek()
                if nt and nt[1] == ";":
                    self.next()
                entries.append(e)
                continue
            key = txt.strip('"') if kind == "str" and not re.search(r"[|.*()\[\]]", txt) else txt
            nt = self.peek()
            if nt and nt[1] == "{":
                self.next()
                ch = self.parse_entries()
                end = self.toks[self.i - 1][2] if self.i else line
                nt2 = self.peek()
                if nt2 and nt2[1] == ";":
                    self.next()
                e = {"k": key, "line": line, "end": end, "t": "dict", "ch": ch, "pre": pre}
                e["post"] = self.take_post(end)
                entries.append(e)
                continue
            parts, items, end = self.read_value()
            e = {"k": key, "line": line, "end": end, "t": "value",
                 "v": join_value(parts), "pre": pre}
            if items:
                e["items"] = items
            e["post"] = self.take_post(end)
            entries.append(e)

    def read_value(self):
        parts, items = [], []
        depth = 0
        end = self.toks[self.i - 1][2] if self.i else 0
        while True:
            t = self.next()
            if t is None:
                break
            kind, txt, line, _ = t
            end = line
            if kind == "p":
                if txt == ";" and depth <= 0:
                    break
                if txt == "{":
                    items.append(self.parse_entries())
                    parts.append("{...}")
                    continue
                if txt == "}":
                    # Missing ';' before the closing brace: give it back
                    self.i -= 1
                    break
                if txt in "([":
                    depth += 1
                elif txt in ")]":
                    depth -= 1
            parts.append(txt)
        self.pending = [p for p in self.pending if p[2] > end]
        return parts, items, end


def parse_dict_text(text):
    return DictParser(text).parse()


def strip_header(entries):
    return [e for e in entries if e["k"] != "FoamFile"]


# --- annotated dictionary: bring back commented-out example entries ---------

STRICT_CODE_RE = re.compile(
    r'^(?:[A-Za-z_"$#][^\s;]*\s+[^;]*;|[A-Za-z_][\w.]*;|[{}()]\s*;?|\);)$')
BARE_WORD_RE = re.compile(r'^[A-Za-z_"][\w.:"<>-]*$')
# Sentences that happen to end with ';' (three words in a row, or quotes)
PROSE_RE = re.compile(r"'|[A-Za-z]{2,}\s+[A-Za-z]{2,}\s+[A-Za-z]{2,}")


def uncomment_examples(text):
    """Uncomment the lines of commented-out example entries.

    Returns (new text, set of uncommented line numbers). Prose comments are
    left untouched.
    """
    lines = text.split("\n")
    out = list(lines)
    flagged = set()
    paren = 0           # open '(' coming from uncommented lines
    brace = 0

    def split_comment(l):
        m = re.match(r"^(\s*)//(.*)$", l)
        if not m:
            return None
        body = m.group(2)
        nested = body.lstrip().startswith("//")
        inner = body
        while inner.lstrip().startswith("//"):
            inner = inner.lstrip()[2:]
        code = re.split(r"\s//", " " + inner, maxsplit=1)[0][1:].strip()
        return m.group(1), body, inner, code, nested

    def next_code(i):
        for j in range(i + 1, min(i + 4, len(lines))):
            sc = split_comment(lines[j])
            if sc is None:
                return lines[j].strip()
            if sc[3]:
                return sc[3]
        return ""

    for i, l in enumerate(lines):
        sc = split_comment(l)
        if sc is None:
            s = blank_comments(l).strip()
            paren += s.count("(") - s.count(")")
            brace += s.count("{") - s.count("}")
            paren, brace = max(paren, 0), max(brace, 0)
            continue
        ind, body, inner, code, nested = sc
        if not code:
            continue
        is_code = bool(STRICT_CODE_RE.match(code)) and not PROSE_RE.search(code)
        if not is_code and paren > 0 and not nested and not code.startswith("-"):
            is_code = True
        if not is_code and BARE_WORD_RE.match(code) and next_code(i) in ("{", "("):
            is_code = True
        if not is_code and not code.endswith((".", ",", ":")) and next_code(i) == "(" \
                and re.match(r"^[A-Za-z_]\w*(\s+\w+)+$", code):
            is_code = True
        if is_code:
            out[i] = ind + inner
            flagged.add(i + 1)
            paren += code.count("(") - code.count(")")
            brace += code.count("{") - code.count("}")
            paren, brace = max(paren, 0), max(brace, 0)
    return "\n".join(out), flagged


