TMPL = r"(<(?:[^<>]|<[^<>]*>)*>)?"
MEMBER_RE = re.compile(
    r"(\w+)\s*(?:\(\s*\))?\s*(?:\.|->)\s*(getOrDefaultCompat|getOrDefault|getCheckOrDefault|"
    r"getCheck|getCompat|get|readIfPresentCompat|readIfPresent|readEntry|found|subDict|"
    r"subOrEmptyDict|optionalSubDict|lookupOrDefault|lookup|isDict|findDict|findEntry)\s*"
    + TMPL + r"\s*\(")
FREE_CALL_RE = re.compile(
    r"(?<![\w.>])(?:meshRefinement::)?(get|subDict|lookup)\s*" + TMPL + r"\s*\(")
VOLTYPE_RE = re.compile(r'volumeType\s*\(\s*"(\w+)"\s*,\s*(\w+)\s*,\s*([\w:]+)\s*\)')
ENUM_RE = re.compile(
    r"Foam::Enum\s*<\s*[\w:]+\s*>\s*(?:[\w:]+::)?(\w+)\s*\(\s*\{(.*?)\}\s*\)", re.S)

REQUIRED_CALLS = {"get", "getCheck", "getCompat", "readEntry", "subDict", "lookup"}


def call_args(text, open_pos):
    """Split the arguments of the call whose '(' is at open_pos."""
    depth = 0
    args, cur = [], []
    i = open_pos
    in_str = False
    while i < len(text):
        ch = text[i]
        if in_str:
            cur.append(ch)
            if ch == "\\":
                cur.append(text[i + 1])
                i += 1
            elif ch == '"':
                in_str = False
        elif ch == '"':
            in_str = True
            cur.append(ch)
        elif ch in "({[":
            depth += 1
            if depth > 1:
                cur.append(ch)
        elif ch in ")}]":
            depth -= 1
            if depth == 0:
                args.append("".join(cur).strip())
                return args
            cur.append(ch)
        elif ch == "," and depth == 1:
            args.append("".join(cur).strip())
            cur = []
        else:
            cur.append(ch)
        i += 1
    return args


def scan_enums(root):
    enums = {}
    for rel in ENUM_FILES:
        txt = blank_comments(read_text(root / rel))
        for m in ENUM_RE.finditer(txt):
            pairs = re.findall(r'\{\s*([\w:]+)\s*,\s*"(\w+)"\s*\}', m.group(2))
            enums[m.group(1)] = {"names": [p[1] for p in pairs],
                                 "consts": {p[0].split("::")[-1]: p[1] for p in pairs},
                                 "src": f"{rel}:{line_of(txt, m.start())}"}
    return enums


def scan_movers(root):
    names = []
    d = root / MOVER_DIR
    for f in sorted(d.glob("*.C")):
        txt = blank_comments(read_text(f))
        m = re.search(r"addToRunTimeSelectionTable\s*\(\s*externalDisplacementMeshMover\s*,\s*(\w+)", txt)
        if m:
            h = read_text(f.with_suffix(".H"))
            t = re.search(r'TypeName\s*\(\s*"(\w+)"\s*\)', h)
            names.append(t.group(1) if t else m.group(1))
    return names


DEFAULT_PRETTY = {
    "labelMin": "labelMin (disabled)",
    "labelMax": "labelMax (unlimited)",
    "pointField(0)": "() (none)",
    "mesh().globalData().nTotalPoints()": "number of mesh points (unlimited)",
    "coordSetWriters::vtkWriter::typeName": "vtk",
    "surfaceWriters::vtkWriter::typeName": "vtk",
    "GREAT": "1e15 (GREAT)",
    "-GREAT": "-1e15 (-GREAT)",
    "fileName::null": "\"\" (none)",
    "vector::zero": "(0 0 0)",
    "labelPair(0, 0)": "(0 0)",
    "nullGapLevel": "(0 0 0) (no gap refinement)",
    "key": "the geometry entry name",
    "gapLevelIncrement": "castellatedMeshControls/gapLevelIncrement",
}
# Per-region values that default to the per-surface value
SURFACE_DEFAULT_RE = re.compile(r"global\w*\[surfI\]|labelPair\s*\(\s*globalMinLevel")


def pretty_default(d, txt, root):
    """Turn a C++ default expression into something readable."""
    d = re.sub(r"\s+", " ", d).strip()
    d = re.sub(r"^(?:Switch|scalar|label|word|bool)\((.*)\)$", r"\1", d)
    if d in DEFAULT_PRETTY:
        return DEFAULT_PRETTY[d]
    if SURFACE_DEFAULT_RE.search(d):
        return "value of the surface"
    m = re.fullmatch(r'\w+\.get<\w+>\("(\w+)"\)', d)
    if m:
        return f"value of {m.group(1)}"
    m = re.fullmatch(r"\(?([\d.]+)\s*\*\s*(\w+?)_?\)?", d)
    if m:
        return f"{m.group(1)}*{m.group(2)}"
    if re.fullmatch(r"[a-z]\w*_", d):
        return f"value of {d[:-1]}"
    m = re.fullmatch(r"(\w+)::typeName", d)
    if m:
        for h in (root / MOVER_DIR).glob(m.group(1) + ".H"):
            t = re.search(r'TypeName\s*\(\s*"(\w+)"\s*\)', read_text(h))
            if t:
                return t.group(1)
    if re.fullmatch(r"[A-Za-z_]\w*", d) and d not in ("true", "false", "on", "off", "yes", "no"):
        m = re.search(r"\b" + d + r"\s*=\s*([^;]+);", txt)
        if m and re.fullmatch(r"[-+\d.eE]+", m.group(1).strip()):
            return m.group(1).strip()
    return d


def scan_sources(root, enums):
    """Return {generic path: [read records]} and a list of unmapped reads."""
    reads = {}
    unmapped = []

    def add(rel, txt, pos, call, var, key, tmpl, default, enum=None):
        if key in INTERNAL_KEYS:
            return
        mapping = dict(SCAN)[rel]
        parents = mapping.get(var)
        ln = line_of(txt, pos)
        if parents is None:
            unmapped.append(f"{rel}:{ln} {var}.{call}(\"{key}\")")
            return
        if isinstance(parents, str):
            parents = [parents]
        for par in parents:
            path = f"{par}/{key}" if par else key
            reads.setdefault(path, []).append({
                "call": call, "file": rel, "line": ln,
                "type": (tmpl or "").strip("<>").replace(" ", ""),
                "default": default, "enum": enum,
                "required": call in REQUIRED_CALLS and default is None,
            })

    for rel, _ in SCAN:
        raw = read_text(root / rel)
        if not raw:
            continue
        txt = blank_comments(raw)
        for m in MEMBER_RE.finditer(txt):
            var, call, tmpl = m.group(1), m.group(2), m.group(3)
            args = call_args(txt, m.end() - 1)
            if not args or not re.fullmatch(r'"\w+"', args[0]):
                continue
            key = args[0].strip('"')
            default = None
            enum = None
            if var.endswith(("Names", "Names_")):
                enum = var
                dvar = args[1] if len(args) > 1 else ""
                if call.startswith("getOrDefault") and len(args) > 2:
                    const = args[2].split("::")[-1]
                    default = enums.get(var, {}).get("consts", {}).get(const, args[2])
                var = dvar
            elif call.startswith(("getOrDefault", "lookupOrDefault", "getCheckOrDefault")):
                default = pretty_default(args[1], txt, root) if len(args) > 1 else ""
            add(rel, txt, m.start(), call, var, key, tmpl, default, enum)
        for m in FREE_CALL_RE.finditer(txt):
            call, tmpl = m.group(1), m.group(2)
            args = call_args(txt, m.end() - 1)
            if len(args) < 2 or not re.fullmatch(r"\w+", args[0]) \
                    or not re.fullmatch(r'"\w+"', args[1]):
                continue
            default = pretty_default(args[4], txt, root) if len(args) > 4 else None
            add(rel, txt, m.start(), call, args[0], args[1].strip('"'), tmpl, default)
        for m in VOLTYPE_RE.finditer(txt):
            add(rel, txt, m.start(), "volumeType", m.group(2), m.group(1), "",
                m.group(3).split("::")[-1].lower())
    return reads, unmapped


def scan_geometry_types(root):
    """searchableSurface types registered in the sources."""
    reg_re = re.compile(
        r"add(Named)?ToRunTimeSelectionTable\s*\(\s*searchableSurface\s*,\s*(\w+)\s*,\s*\w+\s*"
        r"(?:,\s*(\w+)\s*)?\)")
    types = {}
    for sd in SEARCHABLE_DIRS:
        for f in sorted((root / sd).rglob("*.C")):
            if SKIP_DIRS & set(f.parts):
                continue
            txt = blank_comments(read_text(f))
            for m in reg_re.finditer(txt):
                cls = m.group(2)
                e = types.setdefault(cls, {"class": cls, "names": [], "file": None})
                name = m.group(3) if m.group(1) else None
                if name is None:
                    h = read_text(f.with_suffix(".H"))
                    t = re.search(r'TypeName\s*\(\s*"(\w+)"\s*\)', h)
                    name = t.group(1) if t else cls
                    e["file"] = f
                if name not in e["names"]:
                    e["names"].append(name)
                e["file"] = e["file"] or f
    out = {}
    for cls, e in types.items():
        names = sorted(e["names"], key=len)
        short = names[0]
        hpath = e["file"].with_suffix(".H")
        hdr = header_comment(read_text(hpath))
        sec = split_sections(hdr)
        desc_raw = sec.get("Description", "")
        usage = sec.get("Usage", "")
        tables = parse_tables(desc_raw + "\n" + usage)
        verbs = extract_verbatims(desc_raw + "\n" + usage)
        desc = clean_doxygen(desc_raw)
        notes = clean_doxygen(sec.get("Note", ""))
        out[short] = {
            "name": short, "names": names, "class": cls,
            "header": str(hpath.relative_to(root)),
            "description": desc,
            "summary": desc.split("\n\n")[0].replace("\n", " ").strip(),
            "note": notes, "tables": tables, "verbatims": verbs,
            "aliases": GEOM_ALIASES.get(short, ""),
            "tutorials": 0, "examples": [], "keys": {},
        }
    return out


def find_tutorial_dicts(root):
    tdir = root / "tutorials"
    files = []
    for f in sorted(tdir.rglob("snappyHexMeshDict*")):
        if f.is_file() and not (SKIP_DIRS & set(f.parts)) and not f.name.endswith((".orig~", "~")):
            files.append(f)
    return files


