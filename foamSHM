def is_foam_root(path):
    return path is not None and Path(path, "src", "OpenFOAM").is_dir()


def project_dir(arg=None, required=True):
    """Return the OpenFOAM root (explicit argument, $WM_PROJECT_DIR, or two
    levels above this script)."""
    if arg:
        cands = [Path(arg)]
    else:
        cands = []
        env = os.environ.get("WM_PROJECT_DIR")
        if env:
            cands.append(Path(env))
        cands.append(TOOL_DIR.parent.parent)
    for c_ in cands:
        if is_foam_root(c_) or Path(c_, "etc", "caseDicts").is_dir():
            return c_.resolve()
    if required:
        sys.exit("Error: OpenFOAM tree not found. Source the OpenFOAM "
                 "environment (etc/bashrc) or use --src <OpenFOAM root>.")
    return None


