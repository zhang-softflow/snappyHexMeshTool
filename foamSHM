def find_db():
    env = os.environ.get("FOAMSHM_DB")
    if env:
        if not Path(env).is_file():
            sys.exit(f"Error: FOAMSHM_DB={env} not found.")
        return Path(env)
    ver = current_version()
    if ver and user_db_path(ver).is_file():
        return user_db_path(ver)
    return BUNDLED_DB


def load_db():
    path = find_db()
    if not path.is_file():
        sys.exit("Error: database not found. Run 'foamSHM build' first.")
    db = json.loads(path.read_text(encoding="utf-8"))
    ver = current_version()
    if ver and path == BUNDLED_DB and db.get("version") != ver and not os.environ.get("FOAMSHM_QUIET"):
        print(f"Warning: bundled database is for {db.get('version')}, but the "
              f"environment is {ver}. Run 'foamSHM build' for an exact match.",
              file=sys.stderr)
    return db


def use_color():
    return sys.stdout.isatty() and not os.environ.get("NO_COLOR")


def c(text, code):
    return f"\033[{code}m{text}\033[0m" if use_color() else text


def req_flag(k):
    return {"yes": "R", "cond": "C", "no": "o"}.get(k["req"], " ")


def short_desc(k, width=70):
    d = k["desc"] or k["note"]
    d = re.sub(r"\s+", " ", d).strip()
    if not d and k["annotated"] and k["annotated"]["value"]:
        d = "e.g. " + k["annotated"]["value"]
    return d if len(d) <= width else d[: width - 3] + "..."


def when_text(k):
    out = []
    if "addLayers" in k.get("when", []):
        out.append("only read when addLayers is true")
    if "snapOrLayers" in k.get("when", []):
        out.append("only read when snap or addLayers is true (mesh motion)")
    if "medialAxis" in k.get("when", []):
        out.append("only for the default meshShrinker displacementMedialAxis")
    return "; ".join(out)


def legend():
    return ("R: mandatory, C: conditional, o: optional (default shown), "
            "blank: not read directly by snappyHexMesh (documentation/tutorials only)")


def children(db, path):
    kws = db["keywords"]
    return [k for p, k in kws.items() if k["parent"] == path]


def order_key(db, k):
    ann = k["annotated"]
    return (0 if ann else 1, ann["line"] if ann else 0, k["key"].lower())


def cmd_tree(args):
    db = load_db()
    kws = db["keywords"]
    start = resolve_path(db, args.path) if args.path else ""
    if start and start not in kws:
        sys.exit(f"Error: unknown path '{args.path}'.")

    def rec(path, depth):
        for k in sorted(children(db, path), key=lambda k: order_key(db, k)):
            if not args.all and not k["req"] and k["kind"] == "value" and not k["annotated"]:
                continue
            if k["free"] and not args.all:
                continue
            ind = "  " * depth
            name = k["key"] + ("/" if k["kind"] in ("dict", "named", "list") else "")
            dflt = f" = {k['default']}" if k["default"] else ""
            line = f"{ind}{req_flag(k)} {c(name, '1;36')}{dflt}"
            if k["choices"]:
                line += c("  [" + "|".join(k["choices"]) + "]", "33")
            if args.desc and k["kind"] == "value":
                line += c("   " + short_desc(k, 60), "2")
            print(line)
            if args.depth is None or depth + 1 < args.depth:
                rec(k["path"], depth + 1)
    if start:
        k = kws[start]
        print(f"{req_flag(k)} {c(start, '1;36')}")
        rec(start, 1)
    else:
        rec("", 0)
    print()
    print(legend())


def resolve_path(db, name):
    """Accept a full path, a path suffix or a bare keyword."""
    kws = db["keywords"]
    name = name.strip("/")
    if name in kws:
        return name
    # allow real names instead of placeholders: geometry/motorBike.obj/type
    cands = [p for p in kws if p.endswith("/" + name) or p.lower() == name.lower()]
    if len(cands) == 1:
        return cands[0]
    if "/" not in name and cands:
        return sorted(cands)
    parts = name.split("/")
    best = []
    for p in kws:
        pp = p.split("/")
        if len(pp) < len(parts):
            continue
        tail = pp[len(pp) - len(parts):]
        if all(a == b or (b.startswith("<") or b == "{}") for a, b in zip(parts, tail)):
            exact = sum(a == b for a, b in zip(parts, tail))
            best.append((-exact, len(pp), p))
    if best:
        best.sort()
        top = [b for b in best if b[:2] == best[0][:2]]
        if len(top) == 1:
            return top[0][2]
        return [b[2] for b in top]
    return cands or None


def lookup_geometry(db, name):
    low = name.lower()
    for g in db["geometry"].values():
        if low in (n.lower() for n in g["names"]) or low == g["class"].lower():
            return g
    return None


def cmd_search(args):
    db = load_db()
    words = [w.lower() for w in args.keywords]
    hits = []
    kws = db["keywords"]
    for p, k in kws.items():
        if k["key"].startswith("<") or k["key"] == "{}":
            continue
        parts = p.split("/")
        inherited = " ".join(kws.get("/".join(parts[:i]), {}).get("aliases", "")
                             for i in range(1, len(parts)))
        hay = " ".join([p, k["desc"], k["note"], k.get("aliases", ""), inherited,
                        " ".join(k["choices"])]).lower()
        if all(w in hay for w in words):
            score = sum(5 for w in words if w in k["key"].lower()) + \
                sum(3 for w in words if w in k.get("aliases", "").lower()) + \
                sum(1 for w in words if w in k["desc"].lower()) + \
                (2 if k["req"] == "yes" else 0) + (1 if k["tutorials"] else 0)
            hits.append((-score, p))
    ghits = []
    for g in db["geometry"].values():
        hay = " ".join(g["names"] + [g["description"], g["aliases"]]).lower()
        if all(w in hay for w in words):
            ghits.append(g)
    if not hits and not ghits:
        print("No match. Try English keywords, a section name, or 'foamSHM tree'.")
        return
    kws = db["keywords"]
    for _, p in sorted(hits)[: args.max]:
        k = kws[p]
        print(f"{req_flag(k)} {c(p, '1;36')}")
        d = short_desc(k, 100)
        if d:
            print(f"      {d}")
    if len(hits) > args.max:
        print(f"... {len(hits) - args.max} more (use -m)")
    if ghits:
        print(c("\ngeometry types:", "1"))
        for g in ghits:
            print(f"  {c(g['name'], '1;36'):<20} {g['summary'][:90]}")
    print()
    print(legend())


