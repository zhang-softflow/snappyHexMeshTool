def surface_dirs(case):
    return [case / "constant" / "triSurface", case / "constant" / "geometry"]


def case_surfaces(case):
    out = []
    for d in surface_dirs(case):
        if d.is_dir():
            for f in sorted(d.iterdir()):
                if f.is_file() and f.name.lower().endswith(SURFACE_EXT):
                    # compressed files are found without the .gz suffix
                    name = re.sub(r"\.gz$", "", f.name)
                    if name not in out:
                        out.append(name)
    return out


def surf_base(fname):
    b = re.sub(r"\.gz$", "", fname)
    return b.rsplit(".", 1)[0] if "." in b else b


def shape_params(db, gtype):
    if gtype in SHAPE_PARAMS:
        return SHAPE_PARAMS[gtype]
    g = lookup_geometry(db, gtype)
    rows = [r for t in (g["tables"] if g else []) for r in t["rows"]
            if r["reqd"] == "yes" and r["name"] != "type"]
    return [(r["name"], f"<{r['name']}>") for r in rows]


